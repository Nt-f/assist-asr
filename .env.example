# Copy to .env and fill in. Everything but the first two has a working default.

# Home Assistant: its entity/area names and Music Assistant's library become what the model listens for.
# Token: HA -> your profile -> Security -> Long-lived access tokens -> Create token.
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=

# The model: Qwen/Qwen3-ASR-1.7B (better) or Qwen/Qwen3-ASR-0.6B (smaller, faster).
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# Share of the GPU's memory vLLM takes: ~6 GB is plenty for the 1.7B (0.26 of 24 GB), ~4 GB for the 0.6B.
GPU_MEMORY=0.26

# Ports: Wyoming for Home Assistant, vLLM on 127.0.0.1 for the benchmark.
WYOMING_PORT=10300
VLLM_PORT=8100

# Tuning (see README "How it works").
BIAS=1
CONTEXT=1
W_CMD=3.0
W_SLOT=2.5
SLOT_PRIOR=8
SLOT_MARGIN=3
LANGUAGE=en
WAKE_WORDS=alexa|alexis|alex|amazon|computer|echo|ziggy|jarvis|mycroft|nabu

# Keep every request's audio and transcript in data/rec (for bench/label.py). Empty: off.
RECORD_DIR=/data/rec
