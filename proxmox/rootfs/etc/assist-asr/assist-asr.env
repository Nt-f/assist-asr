# Settings of the speech-to-text server; after a change: systemctl restart assist-asr-llama assist-asr-wyoming
# (README "Settings" says what each does.)

# Home Assistant: its names and Music Assistant's library are what the model listens for.
# Token: HA -> your profile -> Security -> Long-lived access tokens.
HASS_URL=
HASS_TOKEN=

# ggml-org/Qwen3-ASR-0.6B-GGUF:Q8_0 (1 GB, faster) or ggml-org/Qwen3-ASR-1.7B-GGUF:Q8_0 (2.5 GB, more accurate).
# Downloaded on first start into /var/lib/assist-asr.
LIGHT_MODEL=ggml-org/Qwen3-ASR-0.6B-GGUF:Q8_0
# auto: the GPU when /dev/dri/renderD128 is passed in (create-ct.sh does that), else the CPU; or cpu, gpu.
DEVICE=auto
LLAMA_ARGS=

PORT=10300
LANGUAGE=en
BIAS=1
CONTEXT=1
W_CMD=3.0
W_SLOT=2.5
SLOT_PRIOR=8
SLOT_MARGIN=3
WAKE_WORDS=alexa|alexis|alex|amazon|computer|echo|ziggy|jarvis|mycroft|nabu
WAKE_FORCE=auto
# Experimental: alternatives for an LLM agent, e.g. sensor.asr_alternatives (README).
ALTERNATIVES=
# Keep every request's audio and transcript (for bench/label.py). Empty: off.
RECORD_DIR=
