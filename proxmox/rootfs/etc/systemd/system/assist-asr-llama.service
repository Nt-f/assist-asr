[Unit]
Description=assist-asr: llama.cpp with Qwen3-ASR
After=network-online.target
Wants=network-online.target

[Service]
User=assist-asr
SupplementaryGroups=render video
EnvironmentFile=/etc/assist-asr/assist-asr.env
# the model is downloaded on first start into HOME's cache
Environment=HOME=/var/lib/assist-asr
ExecStart=/opt/assist-asr/run-llama.sh
StandardOutput=journal+console
StandardError=journal+console
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
